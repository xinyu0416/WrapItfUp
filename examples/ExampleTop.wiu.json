      {
        "name": "learn_source.v",
        "text": "// WIU learning fixture: fixed sample data, enabled by a one-bit input.\n// clk is an interface example; this combinational fixture does not use it.\nmodule learn_source (\n  input clk,\n  input enable,\n  output [7:0] data,\n  output debug\n);\n  assign data = enable ? 8'hA5 : 8'h00;\n  assign debug = enable;\nendmodule\n"
      },
      {
        "name": "learn_sink.v",
        "text": "// WIU learning fixture: report whether any input data bit is high.\n// clk is an interface example; this combinational fixture does not use it.\nmodule learn_sink (\n  input clk,\n  input [7:0] data,\n  output done\n);\n  assign done = |data;\nendmodule\n"
      }
